# Copia questo file in ".env" e compila i valori reali.
# ".env" è ignorato da git (vedi .gitignore): le chiavi non finiscono mai nel repository.
# Queste stesse variabili vanno impostate anche su Vercel
# (Project Settings -> Environment Variables) per gli ambienti Preview e Production.

# --- Database (Neon Postgres) ---
# Connection string del progetto Neon "respiru". Già configurata su Vercel.
DATABASE_URL=

# --- Stripe ---
# Chiave segreta dell'account Stripe (usa la chiave "test" finché non si va in produzione).
# Dashboard Stripe -> Sviluppatori -> Chiavi API -> Chiave segreta.
STRIPE_SECRET_KEY=

# Firma del webhook. Si ottiene creando l'endpoint webhook nella Dashboard Stripe
# (Sviluppatori -> Webhook -> Aggiungi endpoint) puntato a:
#   https://respiru.it/api/stripe-webhook
# sottoscritto agli eventi:
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed
#   checkout.session.expired
# Dopo averlo creato, Stripe mostra il "Signing secret" (comincia con whsec_...).
STRIPE_WEBHOOK_SECRET=

# --- Sito ---
# URL pubblico del sito, usato per costruire i link di redirect dopo il pagamento.
SITE_URL=https://respiru.it

# Versione dei termini della campagna Founding Restaurants mostrati nel checkout
# (vedi /termini-founder). Cambiarla se si aggiornano i termini legali.
FOUNDER_TERMS_VERSION=2026-11-v1
